rules_version = '2';

// Sicherheitsregeln für den Gym Tracker
//
//   users/{uid}                  → Trainingstage, Einstellungen, laufendes Training (nur der Nutzer selbst)
//   users/{uid}/sessions/{id}    → abgeschlossene Einheiten                          (nur der Nutzer selbst)
//   users/{uid}/body/{id}        → Körpermessungen                                   (nur der Nutzer selbst)
//   users/{uid}/friends/{fid}    → Freundesliste
//   profiles/{uid}               → E-Mail, registriert, zuletzt aktiv (für die Nutzerverwaltung)
//   blocked/{uid}                → gesperrte Konten (nur Administratoren dürfen schreiben)
//   usernames/{name}             → eindeutiger Benutzername + Foto (für die Suche, angemeldete Nutzer)
//   publicProfiles/{uid}         → Benutzername, Foto, geteilte Kennzahlen (nur bestätigte Freunde)
//   requests/{from}_{to}         → Freundschaftsanfragen (nur Absender und Empfänger)
//   rooms/{raum}/messages/{id}   → Chat: Nachrichten und Gym-Karten (alle Mitglieder mit Profil)
//   chatState/{uid}              → Zeitpunkt der letzten Chat-Nachricht (Rate Limit gegen Spam)
//   reports/{id}                 → Meldungen aus dem Chat (nur Administratoren dürfen lesen)
//
// Jeder Nutzer darf nur seine eigenen Daten schreiben – solange er nicht gesperrt ist.
// Fremde Profile sind nur für bestätigte Freunde lesbar. Administratoren dürfen alles.
service cloud.firestore {
  match /databases/{database}/documents {

    // ▼▼▼ HIER die Nutzer-ID(s) der Administratoren eintragen ▼▼▼
    // (App → Einstellungen → Konto → Nutzer-ID antippen = kopieren). Mehrere IDs mit Komma trennen.
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['ADMIN-NUTZER-ID-HIER-EINTRAGEN'];
    }

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isBlocked(uid) {
      return exists(/databases/$(database)/documents/blocked/$(uid));
    }

    // eigene Daten (und nicht gesperrt) – oder Administrator
    function canUse(uid) {
      return isAdmin() || (isOwner(uid) && !isBlocked(uid));
    }

    // Steht der anfragende Nutzer in der Freundesliste von uid?
    function isFriendOf(uid) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid));
    }

    function photoOk(d) {
      return d.get('photo', null) == null || (d.photo is string && d.photo.size() < 300000);
    }

    match /users/{uid} {
      allow read, write: if canUse(uid);

      // alle Unter-Sammlungen des Kontos (sessions, body, nutrition, food, friends …)
      match /{collection}/{docId} {
        allow read, write: if canUse(uid);
      }

      // Freundschaft bestätigen: Der Empfänger einer Anfrage uid → fid trägt sich bei uid ein.
      // Beenden darf sie jede Seite.
      match /friends/{fid} {
        allow create: if isOwner(fid) && !isBlocked(fid)
          && exists(/databases/$(database)/documents/requests/$(uid + '_' + fid))
          && request.resource.data.keys().hasOnly(['since']);
        allow delete: if isOwner(fid);
      }
    }

    match /profiles/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if canUse(uid);
    }

    match /blocked/{uid} {
      allow read: if isAdmin() || isOwner(uid);   // der Nutzer darf sehen, DASS er gesperrt ist
      allow write: if isAdmin();
    }

    // nur zum Erkennen, ob jemand Administrator ist
    match /admin/{docId} {
      allow read, write: if isAdmin();
    }

    // ---------- Freunde ----------

    match /usernames/{name} {
      function validName() {
        let d = request.resource.data;
        return name.matches('^[a-z0-9][a-z0-9._]{2,19}$')
          && d.uid == request.auth.uid && d.username == name
          && d.keys().hasOnly(['uid', 'username', 'photo', 'updatedAt'])
          && photoOk(d);
      }
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
      allow create: if signedIn() && !isBlocked(request.auth.uid) && validName();
      allow update: if signedIn() && !isBlocked(request.auth.uid) && resource.data.uid == request.auth.uid && validName();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /publicProfiles/{uid} {
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['username', 'photo', 'stats', 'updatedAt'])
          && d.username is string
          // der Benutzername muss wirklich diesem Konto gehören (auch innerhalb derselben Transaktion)
          && getAfter(/databases/$(database)/documents/usernames/$(d.username)).data.uid == uid
          && photoOk(d)
          && (d.get('stats', null) == null || d.stats is map);
      }
      allow read: if isAdmin() || isOwner(uid) || isFriendOf(uid);
      allow create, update: if canUse(uid) && validProfile();
      allow delete: if canUse(uid);
    }

    match /requests/{id} {
      function validRequest() {
        let d = request.resource.data;
        let mine = get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data;
        return d.keys().hasOnly(['from', 'to', 'fromName', 'fromPhoto', 'toName', 'toPhoto', 'at'])
          && d.from == request.auth.uid
          && d.to is string && d.to != request.auth.uid
          && id == request.auth.uid + '_' + d.to
          // Absender kann sich nicht als jemand anderes ausgeben
          && d.fromName == mine.username && d.get('fromPhoto', null) == mine.get('photo', null)
          && photoOk({ 'photo': d.get('toPhoto', null) })
          && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(d.to));
      }
      allow read: if isAdmin() || (signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid));
      allow create: if signedIn() && !isBlocked(request.auth.uid) && validRequest();
      allow delete: if isAdmin() || (signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid));
    }

    // ---------- Chat ----------
    //
    // Raum „gym“ gibt es immer. Weitere Räume (z. B. pro Standort): Administrator legt ein Dokument
    // rooms/{raumname} an (Raumname: a–z, 0–9, Bindestrich) – danach funktioniert der Raum ohne weitere Änderung.
    // Mitglied = angemeldet, nicht gesperrt und mit Profil (Benutzername).

    function profileName(uid) {
      return get(/databases/$(database)/documents/publicProfiles/$(uid)).data.get('username', null);
    }

    function hasProfile(uid) {
      return exists(/databases/$(database)/documents/publicProfiles/$(uid)) && profileName(uid) is string;
    }

    function chatMember() {
      return signedIn() && !isBlocked(request.auth.uid) && hasProfile(request.auth.uid);
    }

    function chatTextOk(t) {
      return t is string && t.size() <= 500 && t.matches('(?s).*\\S.*');
    }

    // Zeit, Art und Notiz einer Gym-Karte: Start höchstens 6 h in der Vergangenheit und 60 Tage in der Zukunft
    function cardFieldsOk(d) {
      return d.when is int
        && d.when >= request.time.toMillis() - 21600000
        && d.when <= request.time.toMillis() + 5184000000
        && d.workout in ['', 'push', 'pull', 'legs', 'upper', 'lower', 'fullbody', 'cardio', 'other']
        && d.note is string && d.note.size() <= 120;
    }

    match /rooms/{room} {
      function knownRoom() {
        return room == 'gym' || exists(/databases/$(database)/documents/rooms/$(room));
      }
      allow read: if chatMember();
      allow write: if isAdmin();

      match /messages/{id} {
        // Neue Nachricht: eigener Name aus dem Profil, Serverzeit, Rate Limit (Nachricht + chatState im selben Batch)
        function validNew() {
          let d = request.resource.data;
          let st = /databases/$(database)/documents/chatState/$(request.auth.uid);
          let isCard = d.kind == 'gym';
          return d.uid == request.auth.uid
            && d.name == profileName(request.auth.uid)
            && d.createdAt == request.time
            && (
              (d.kind == 'text'
                && d.keys().hasOnly(['uid', 'name', 'kind', 'text', 'createdAt'])
                && chatTextOk(d.text))
              || (isCard
                && d.keys().hasOnly(['uid', 'name', 'kind', 'createdAt', 'when', 'workout', 'note', 'joined'])
                && cardFieldsOk(d)
                && d.joined is map && d.joined.size() == 0)
            )
            // höchstens eine Nachricht alle 2 Sekunden, eine Gym-Karte pro Minute
            && getAfter(st).data.lastPostAt == request.time
            && (!exists(st) || get(st).data.get('lastPostAt', null) == null
                || get(st).data.lastPostAt < request.time - duration.value(2, 's'))
            && (!isCard || (getAfter(st).data.lastCardAt == request.time
                && (!exists(st) || get(st).data.get('lastCardAt', null) == null
                    || get(st).data.lastCardAt < request.time - duration.value(60, 's'))));
        }

        // Der Autor ändert Text bzw. Zeit/Art/Notiz seiner Karte
        function validOwnerEdit() {
          let n = request.resource.data;
          let o = resource.data;
          let changed = n.diff(o).affectedKeys();
          return o.uid == request.auth.uid
            && n.editedAt == request.time
            && (
              (o.kind == 'text' && changed.hasOnly(['text', 'editedAt']) && chatTextOk(n.text))
              || (o.kind == 'gym' && changed.hasOnly(['when', 'workout', 'note', 'editedAt']) && cardFieldsOk(n))
            );
        }

        // Jeder Mitglied darf sich selbst in die Teilnehmerliste einer Karte eintragen bzw. austragen – nur sich selbst
        function validJoin() {
          let n = request.resource.data;
          let o = resource.data;
          return o.kind == 'gym'
            && n.diff(o).affectedKeys().hasOnly(['joined'])
            && n.joined.diff(o.joined).affectedKeys().hasOnly([request.auth.uid])
            && n.joined.size() <= 40
            && (!(request.auth.uid in n.joined) || n.joined[request.auth.uid] == profileName(request.auth.uid));
        }

        allow get: if isAdmin() || (chatMember() && knownRoom());
        allow list: if (isAdmin() || chatMember()) && knownRoom() && request.query.limit <= 50;
        allow create: if chatMember() && knownRoom() && validNew();
        allow update: if chatMember() && knownRoom() && (validOwnerEdit() || validJoin());
        allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    match /chatState/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && chatMember()
        && request.resource.data.keys().hasOnly(['lastPostAt', 'lastCardAt'])
        && request.resource.data.lastPostAt == request.time
        && (!('lastCardAt' in request.resource.data)
            || request.resource.data.lastCardAt == request.time
            || (resource != null && request.resource.data.lastCardAt == resource.data.get('lastCardAt', null)));
      // erst nach dem Löschen des Profils (Konto löschen) – sonst ließe sich das Rate Limit zurücksetzen
      allow delete: if isAdmin() || (isOwner(uid) && !hasProfile(uid));
    }

    // Meldungen: je Melder und Nachricht eine (Dokument-ID), nur Administratoren lesen
    match /reports/{id} {
      allow create: if chatMember()
        && request.resource.data.keys().hasOnly(['room', 'msgId', 'targetUid', 'targetName', 'text', 'reason', 'reporter', 'at'])
        && request.resource.data.reporter == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.msgId
        && request.resource.data.room is string && request.resource.data.room.size() <= 30
        && request.resource.data.msgId is string && request.resource.data.msgId.size() <= 40
        && request.resource.data.targetUid is string && request.resource.data.targetUid.size() <= 128
        && request.resource.data.targetName is string && request.resource.data.targetName.size() <= 30
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.reason in ['spam', 'abuse', 'other']
        && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
    }
  }
}
